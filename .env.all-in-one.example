AIO_IMAGE=bc-atlas-cms-all-in-one
AIO_TAG=local
APP_VERSION=dev
BASE_IMAGE=bc-atlas-cms-base
BASE_TAG=2026.08.12
MYSQL_IMAGE=mysql:8.4
NODE_IMAGE=node:24.18.1-bookworm-slim
GO_IMAGE=golang:1.24.8-bookworm
MINIO_SOURCE_REPOSITORY=https://github.com/minio/minio.git
MINIO_SOURCE_REF=7aac2a2c5b7c882e68c1ce017d8256be2feea27f

# Public application listener. Use 127.0.0.1 behind a tunnel or reverse proxy.
APP_BIND=0.0.0.0
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# Host-only maintenance ports. The application uses fixed internal ports.
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3306
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MYSQL_DATABASE=bc_cms
MYSQL_USER=bc
MYSQL_PASSWORD=replace-with-a-private-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-private-random-value
MINIO_ROOT_USER=bc-minio
MINIO_ROOT_PASSWORD=replace-with-a-private-random-value
S3_BUCKET=bc-content

ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-private-random-value
ADMIN_DISPLAY_NAME=B.C
